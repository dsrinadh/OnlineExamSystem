//Create DataBases
CREATE DATABASE online_exam;

//Create User Table
CREATE TABLE users (
    ->     username VARCHAR(50),
    ->     password VARCHAR(50)
    -> );

//Create Question Table
CREATE TABLE questions (
    ->     id INT PRIMARY KEY AUTO_INCREMENT,
    ->     question VARCHAR(255),
    ->     option1 VARCHAR(100),
    ->     option2 VARCHAR(100),
    ->     option3 VARCHAR(100),
    ->     option4 VARCHAR(100),
    ->     correct_answer VARCHAR(100));

//Create table Result
CREATE TABLE results (
    ->     id INT PRIMARY KEY AUTO_INCREMENT,
    ->     username VARCHAR(50),
    ->     score INT
    -> );

